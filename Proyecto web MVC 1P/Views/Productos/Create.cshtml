@model Proyecto_web_MVC_1P.Models.Proyecto_web_MVC_1P.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0">Crear Nuevo Producto</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="UsuarioId" class="form-label">Vendedor</label>
                                    <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId">
                                        <option value="">-- Seleccionar Vendedor --</option>
                                    </select>
                                    <span asp-validation-for="UsuarioId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="NombreProducto" class="form-label">Nombre del Producto</label>
                                    <input asp-for="NombreProducto" class="form-control" placeholder="Ej: Hamburguesa Clásica" />
                                    <span asp-validation-for="NombreProducto" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Describe tu producto..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Precio" class="form-label">Precio</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="Precio" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="TipoProducto" class="form-label">Tipo de Producto</label>
                                    <select asp-for="TipoProducto" class="form-select">
                                        <option value="">-- Seleccionar Tipo --</option>
                                        <option value="Comida">Comida</option>
                                        <option value="Bebida">Bebida</option>
                                        <option value="Postre">Postre</option>
                                        <option value="Snack">Snack</option>
                                        <option value="Otro">Otro</option>
                                    </select>
                                    <span asp-validation-for="TipoProducto" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Categoria" class="form-label">Categoría</label>
                                    <select asp-for="Categoria" class="form-select">
                                        <option value="">-- Seleccionar Categoría --</option>
                                        <option value="Comida Rápida">Comida Rápida</option>
                                        <option value="Comida Saludable">Comida Saludable</option>
                                        <option value="Bebidas">Bebidas</option>
                                        <option value="Postres">Postres</option>
                                        <option value="Snacks">Snacks</option>
                                        <option value="Otros">Otros</option>
                                    </select>
                                    <span asp-validation-for="Categoria" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ImagenUrl" class="form-label">URL de la Imagen (opcional)</label>
                            <input asp-for="ImagenUrl" class="form-control" placeholder="https://ejemplo.com/imagen.jpg" />
                            <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                            <div class="form-text">Deja vacío si no tienes una imagen</div>
                        </div>

                        <div class="form-group mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Disponibilidad" type="checkbox" checked />
                                <label class="form-check-label" asp-for="Disponibilidad">
                                    Producto disponible para venta
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-success">Crear Producto</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}