@model IEnumerable<Proyecto_web_MVC_1P.Models.Proyecto_web_MVC_1P.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Lista de Productos</h1>

            <!-- Botón para agregar nuevo producto -->
            <div class="mb-3">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> Agregar Nuevo Producto
                </a>
            </div>

            <!-- Tabla de productos -->
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Imagen</th>
                            <th>Nombre del Producto</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Tipo</th>
                            <th>Categoría</th>
                            <th>Vendedor</th>
                            <th>Fecha</th>
                            <th>Disponible</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" alt="@item.NombreProducto"
                                                 style="width: 50px; height: 50px; object-fit: cover;"
                                                 class="rounded" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                 style="width: 50px; height: 50px;">
                                                <i class="fas fa-image text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.NombreProducto</strong>
                                    </td>
                                    <td>
                                        <span title="@item.Descripcion">
                                            @(item.Descripcion.Length > 50 ? item.Descripcion.Substring(0, 50) + "..." : item.Descripcion)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">$@item.Precio.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.TipoProducto</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Categoria</span>
                                    </td>
                                    <td>
                                        @if (item.Usuario != null)
                                        {
                                            @item.Usuario.NombreUsuario
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin asignar</span>
                                        }
                                    </td>
                                    <td>
                                        @item.FechaPublicacion.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @if (item.Disponibilidad)
                                        {
                                            <span class="badge bg-success">Disponible</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">No disponible</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted py-4">
                                    <i class="fas fa-box-open fa-3x mb-3"></i>
                                    <br>
                                    No hay productos registrados
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Font Awesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
}

@section Styles {
    <link href="@Url.Content("~/css/index.css")" rel="stylesheet" />
    <style>
        .table th {
            border-top: none;
        }
        .btn-group .btn {
            margin-right: 2px;
        }
        .table-responsive {
            border-radius: 0.5rem;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
    </style>
}